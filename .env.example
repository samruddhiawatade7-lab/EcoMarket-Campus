# Database Configuration
DB_URL=jdbc:mysql://localhost:3306/ecomarket_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=root

# Security JWT Configuration
